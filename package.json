{
  "name": "facenox-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter facenox dev",
    "build:app": "pnpm --filter facenox build",
    "build:server": "pnpm --filter facenox-server build",
    "build": "pnpm -r build",
    "dist:win": "pnpm --filter facenox dist:win",
    "dist:mac": "pnpm --filter facenox dist:mac",
    "dist:linux": "pnpm --filter facenox dist:linux",
    "clean:app": "pnpm --filter facenox run clean",
    "clean:server": "pnpm --filter facenox-server run clean",
    "clean": "pnpm -r run clean",
    "lint:app": "pnpm --filter facenox lint",
    "lint:server": "pnpm --filter facenox-server lint",
    "lint": "pnpm -r lint",
    "format:app": "pnpm --filter facenox format",
    "format:server": "pnpm --filter facenox-server format",
    "format": "pnpm -r format",
    "fix": "pnpm -r fix"
  },
  "license": "AGPL-3.0"
}
