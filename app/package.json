{
  "name": "facenox",
  "private": true,
  "version": "1.0.0-beta.12",
  "description": "Real-time AI attendance tracker with face recognition.",
  "author": "FACENOX <support@facenox.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/facenox/facenox.git"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:renderer": "node ./scripts/preview-renderer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "clean": "npx rimraf out dist release build .vite .tmp .electron-vite",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "fix": "npm run lint && npm run format",
    "transpile:electron": "electron-vite build --mode main",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "framer-motion": "^12.43.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^42.9.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
