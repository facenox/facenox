{
  "name": "facenox",
  "private": true,
  "version": "1.0.0-beta.28",
  "description": "Open-source, privacy-first face recognition software for attendance tracking.",
  "author": "Facenox <support@facenox.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/facenox/facenox.git"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:renderer": "node ./scripts/preview-renderer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "clean": "npx rimraf out dist release build .vite .tmp .electron-vite",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "fix": "npm run lint && npm run format",
    "transpile:electron": "electron-vite build --mode main",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "ably": "^2.30.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-store": "^12.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
